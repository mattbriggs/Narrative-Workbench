  "radius": {
    "$type": "dimension",
    "base": {
      "sm": {
        "$value": {
          "value": 4,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 8,
          "unit": "px"
        }
      }
    },
    "role": {
      "control": {
        "$value": "{radius.base.sm}"
      },
      "panel": {
        "$value": "{radius.base.md}"
      }
    }
  },
  "duration": {
    "$type": "duration",
    "base": {
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "standard": {
        "$value": {
          "value": 180,
          "unit": "ms"
        }
      }
    },
    "role": {
      "feedback": {
        "$value": "{duration.base.fast}"
      },
      "panel": {
        "$value": "{duration.base.standard}"
      }
    }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "base": {
      "sans": {
        "$value": [
          "Inter",
          "Segoe UI",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "IBM Plex Mono",
          "Consolas",
          "monospace"
        ]
      }
    },
    "role": {
      "interface": {
        "$value": "{fontFamily.base.sans}"
      },
      "data": {
        "$value": "{fontFamily.base.mono}"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "role": {
      "app-title": {
        "$value": {
          "fontFamily": "{fontFamily.role.interface}",
          "fontSize": {
            "value": 18,
            "unit": "px"
          },
          "fontWeight": 650,
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          },
          "lineHeight": 1.25
        }
      },
      "pane-header": {
        "$value": {
          "fontFamily": "{fontFamily.role.interface}",
          "fontSize": {
            "value": 14,
            "unit": "px"
          },
          "fontWeight": 650,
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          },
          "lineHeight": 1.35
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{fontFamily.role.interface}",
          "fontSize": {
            "value": 14,
            "unit": "px"
          },
          "fontWeight": 400,
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          },
          "lineHeight": 1.45
        }
      },
      "label": {
        "$value": {
          "fontFamily": "{fontFamily.role.interface}",
          "fontSize": {
            "value": 12,
            "unit": "px"
          },
          "fontWeight": 600,
          "letterSpacing": {
            "value": 0.1,
            "unit": "px"
          },
          "lineHeight": 1.3
        }
      },
      "data": {
        "$value": {
          "fontFamily": "{fontFamily.role.data}",
          "fontSize": {
            "value": 12,
            "unit": "px"
          },
          "fontWeight": 400,
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          },
          "lineHeight": 1.4
        }
      }
    }
