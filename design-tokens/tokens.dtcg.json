      "separator-width": {
        "$value": {
          "value": 1,
          "unit": "px"
        }
      },
      "navigator-wide": {
        "$value": {
          "value": 252,
          "unit": "px"
        }
      },
      "inspector-wide": {
        "$value": {
          "value": 320,
          "unit": "px"
        }
      },
      "trace-default": {
        "$value": {
          "value": 220,
          "unit": "px"
        }
      }
    }
