        "$value": "#FFFFFF"
      },
      "ink-950": {
        "$value": "#17212B"
      },
      "ink-700": {
        "$value": "#3F4D5A"
      },
      "ink-500": {
        "$value": "#687684"
      },
      "gray-300": {
        "$value": "#D9E0E7"
      },
      "gray-100": {
        "$value": "#F4F6F8"
      },
      "blue-900": {
        "$value": "#173A63"
      },
      "blue-700": {
        "$value": "#2C67A1"
      },
      "blue-100": {
        "$value": "#EAF2F8"
      },
      "green-700": {
        "$value": "#267A4A"
